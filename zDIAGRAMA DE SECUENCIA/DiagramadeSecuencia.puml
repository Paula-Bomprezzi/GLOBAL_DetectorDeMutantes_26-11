@startuml
skinparam style strictuml
skinparam lifelineStrategy solid
title Detección de Mutantes y Estadísticas

actor Cliente
participant "MutantController\n(/mutant, /stats, /health, /mutant/{hash})" as Controller
participant "MutantService" as MutantService
participant "MutantDetector" as Detector
participant "StatsService" as StatsService
participant "DnaRecord (Entity)" as Entity
participant "DnaRecordRepository" as Repo
database "Base de Datos H2" as DB

== POST /mutant ==
Cliente -> Controller: POST /mutant {dna}
activate Controller
Controller -> MutantService: analyzeDna(dna)
activate MutantService
MutantService -> MutantService: calculateDnaHash(dna)
MutantService -> Repo: findByDnaHash(hash)
activate Repo
Repo -> DB: SELECT dna_hash = hash
DB --> Repo: Optional<DnaRecord>
Repo --> MutantService: ADN encontrado?
deactivate Repo

alt ADN ya registrado
    MutantService --> Controller: CompletableFuture(isMutant)
else Nuevo ADN
    MutantService -> Detector: isMutant(dna)
    activate Detector
    Detector --> MutantService: boolean isMutant
    deactivate Detector

    ' Creación de la entity (línea punteada, sin activación)
    MutantService -> Entity: new DnaRecord(hash, isMutant, timestamp)
    Entity --> MutantService: DnaRecord creado

    MutantService -> Repo: save(DnaRecord)
    activate Repo
    Repo -> DB: INSERT registro
    DB --> Repo: confirmación
    Repo --> MutantService: DnaRecord persistido
    deactivate Repo

    MutantService --> Controller: CompletableFuture(isMutant)
end
deactivate MutantService
Controller -> Cliente: HTTP 200 OK / 403 Forbidden
deactivate Controller

== GET /stats ==
Cliente -> Controller: GET /stats
activate Controller
Controller -> StatsService: getStats()
activate StatsService

StatsService -> Repo: countByIsMutant(true)
activate Repo
Repo -> DB: SELECT COUNT is_mutant = true
DB --> Repo: total mutantes
Repo --> StatsService: m
deactivate Repo

StatsService -> Repo: countByIsMutant(false)
activate Repo
Repo -> DB: SELECT COUNT is_mutant = false
DB --> Repo: total humanos
Repo --> StatsService: h
deactivate Repo

StatsService -> StatsService: ratio = m / h
StatsService --> Controller: StatsResponse{m,h,ratio}
deactivate StatsService

Controller --> Cliente: HTTP 200 OK + JSON stats
deactivate Controller

== GET /health ==
Cliente -> Controller: GET /health
activate Controller
Controller -> Controller: Crear HashMap {status: "UP", timestamp}
Controller --> Cliente: HTTP 200 OK + JSON {status, timestamp}
deactivate Controller

== DELETE /mutant/{hash} ==
Cliente -> Controller: DELETE /mutant/{hash}
activate Controller
Controller -> MutantService: deleteByHash(hash)
activate MutantService
MutantService -> Repo: findByDnaHash(hash)
activate Repo
Repo -> DB: SELECT dna_hash = hash
DB --> Repo: Optional<DnaRecord>
Repo --> MutantService: Optional<DnaRecord>
deactivate Repo

alt Registro encontrado
    MutantService -> Repo: delete(DnaRecord)
    activate Repo
    Repo -> DB: DELETE registro
    DB --> Repo: confirmación
    Repo --> MutantService: eliminado
    deactivate Repo
    MutantService --> Controller: ResponseEntity.ok()
    Controller --> Cliente: HTTP 200 OK
else Registro no encontrado
    MutantService --> Controller: ResponseEntity.notFound()
    Controller --> Cliente: HTTP 404 Not Found
end
deactivate MutantService
deactivate Controller

@enduml
